{
  "name": "responseable",
  "version": "0.1.0",
  "description": "Open-source incident war rooms for IT operations, security, and business continuity.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "prebuild": "node scripts/board-assets.mjs",
    "predev": "node scripts/board-assets.mjs",
    "test": "node scripts/aws-notification-test.mjs && node scripts/acceptance.mjs"
  },
  "keywords": [
    "incident-response",
    "incident-management",
    "business-continuity",
    "crisis-communications",
    "self-hosted",
    "livekit",
    "sms-alerting"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1169.0",
    "@base-ui/react": "^1.9.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@livekit/components-react": "^2.9.25",
    "@livekit/components-styles": "^1.2.0",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "livekit-client": "^2.24.1",
    "livekit-server-sdk": "^2.19.3",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
